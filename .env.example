PORT=3000
NODE_ENV=production

# Render PostgreSQL / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controlefinanceiro?schema=public

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy...

# Filtros do WhatsApp (JID do grupo alvo, ex: 120363xxxxxxxxx@g.us)
TARGET_GROUP_JID=120363xxxxxxxxx@g.us

# Senha/Token de acesso para ver o QR Code na Web (?token=sua_senha_secreta_aqui)
ADMIN_WEB_TOKEN=sua_senha_secreta_para_ver_o_qr

# URL da aplicação para o auto-ping anti-hibernação (no Render é preenchido automaticamente via RENDER_EXTERNAL_URL)
APP_URL=https://seu-app.onrender.com

# Intervalo do Auto-Ping HTTP anti-sono (minutos)
KEEP_ALIVE_INTERVAL_MINUTES=10

# Intervalo do Ping no PostgreSQL para manter o pool aquecido (minutos)
DB_KEEP_ALIVE_INTERVAL_MINUTES=5
